# Copy to photo-sync/.env (gitignored) or export these in your shell.
# Real environment variables win over values in .env.

# Archive root: <ROOT>/<YEAR>/<MM-DD-YYYY Name>/_web/*.jpg
PHOTO_SOURCE_ROOT=/Volumes/PhotoArchive

# local = write into LOCAL_TARGET_DIR (dev); s3 = upload to Backblaze B2 (S3 API)
TARGET=local
# Relative paths in this file resolve against this file's folder (photo-sync/).
LOCAL_TARGET_DIR=../public/local-photos

# Required when TARGET=s3
S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
S3_BUCKET=
S3_KEY_ID=
S3_APP_KEY=

# Public URL the site loads photos from (Cloudflare in front of B2).
# Written into photos.json as base_url. Leave empty for local dev.
PUBLIC_BASE_URL=

WATERMARK_TEXT=@jak_creative_
WATERMARK_OPACITY=0.55
# Text height as a fraction of the photo's short side (0.07 = 7%).
WATERMARK_SIZE=0.07
